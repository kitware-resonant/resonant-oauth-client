{
  "name": "@resonant/oauth-client",
  "version": "0.0.0",
  "description": "A TypeScript library for performing OAuth2 login to a Resonant server.",
  "repository": "github:kitware-resonant/resonant-oauth-client",
  "author": "Kitware, Inc. <kitware@kitware.com>",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=16"
  },
  "module": "./dist/index.js",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "/src/",
    "/dist/"
  ],
  "scripts": {
    "test:lint": "biome check --error-on-warnings",
    "test:type": "tsc --project ./tests",
    "test:unit": "vitest run",
    "test": "npm-run-all test:*",
    "format": "biome check --write --error-on-warnings",
    "watch": "tsc --watch",
    "build:clean": "rimraf ./dist",
    "build:compile": "tsc",
    "build": "npm-run-all build:clean build:compile",
    "prepack": "npm-run-all build"
  },
  "dependencies": {
    "@openid/appauth": "^1.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.1",
    "@node-oauth/oauth2-server": "^5.2.0",
    "@resonant/biome-config": "^0.3.0",
    "@tsconfig/recommended": "^1.0.8",
    "@types/jquery": "^3.5.32",
    "@vitest/coverage-v8": "4.0.18",
    "happy-dom": "^20.0.0",
    "msw": "^2.8.0",
    "npm-run-all2": "^8.0.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.0",
    "vitest": "^4.0.8"
  }
}
