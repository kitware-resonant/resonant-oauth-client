{
  "name": "@resonant/oauth-client",
  "version": "0.0.0",
  "description": "A TypeScript library for performing OAuth2 login to a Resonant server.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitware-resonant/resonant-oauth-client.git"
  },
  "license": "Apache-2.0",
  "author": "Kitware, Inc. <kitware@kitware.com>",
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "NOTICE",
    "/src/",
    "/dist/"
  ],
  "scripts": {
    "build": "npm-run-all build:clean build:compile",
    "build:clean": "rimraf ./dist",
    "build:compile": "tsc",
    "example": "vite ./example",
    "example:build": "vite build ./example",
    "format": "biome check --write --error-on-warnings",
    "prepack": "npm-run-all build",
    "test": "npm-run-all test:*",
    "test:lint": "biome ci --error-on-warnings",
    "test:type": "tsc --project ./tests",
    "test:unit": "vitest run",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@openid/appauth": ">=1.3.2 <1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@node-oauth/oauth2-server": "5.3.1",
    "@resonant/biome-config": "0.5.0",
    "@vitest/coverage-v8": "5.0.5",
    "happy-dom": "21.0.4",
    "msw": "3.0.3",
    "npm-run-all2": "9.0.4",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.15"
    }
  }
}
